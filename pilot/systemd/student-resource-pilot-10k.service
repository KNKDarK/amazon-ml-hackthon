[Unit]
Description=Supervised 10K training-only entity-resolution pilot
Documentation=https://github.com/KNKDarK/amazon-ml-hackthon
After=default.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/amazon-ml-hackthon
Environment=PYTHON=%h/amazon-ml-hackthon/.venv/bin/python
Environment=DATA_ROOT=%h/amazon-ml-hackthon/dataset
Environment=WORK_DIR=%h/amazon-ml-hackthon/artifacts/pilot_10k_supervised
Environment=SELECTION_CAP=500
Environment=MAX_PROJECTED_POSTINGS=5000000
ExecStart=%h/amazon-ml-hackthon/pilot/launch_supervised_pilot.sh
SyslogIdentifier=student-resource-pilot-10k
TimeoutStartSec=infinity
TimeoutStopSec=120s
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
Restart=no
UMask=0022
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
